{
  "name": "realms",
  "main": "expo-router/entry",
  "version": "1.2.4",
  "description": "Realms — A D&D 5e (2024) character manager for managing characters, spells, equipment, and resources.",
  "author": {
    "name": "Alireza Dolatabadi"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.17",
    "@expo/ui": "~57.0.26",
    "@expo/vector-icons": "^15.0.2",
    "better-sqlite3": "^13.0.3",
    "expo": "~57.0.31",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.4",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.29",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.24",
    "expo-splash-screen": "~57.0.10",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-devtools": "^8.0.0",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "web:build": "expo export --platform web",
    "desktop:dev": "electron electron/main.cjs",
    "desktop:dir": "npm run web:build && electron-builder --dir",
    "desktop:dist": "npm run web:build && electron-builder"
  },
  "build": {
    "appId": "com.realms.realms",
    "productName": "Realms",
    "directories": {
      "output": "release"
    },
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/images/realms.ico",
      "target": "nsis"
    },
    "mac": {
      "icon": "assets/images/realms.icns",
      "target": "dmg"
    }
  },
  "private": true
}
